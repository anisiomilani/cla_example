      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define B0 0.0006\n"
"#define B1 -0.0005\n"
"#define B2 0\n"
"#define A1 -1.000000\n"
"#define A2 0\n"
"\n"
"\n"
"#define REF 70\n"
"#define UL 1\n"
"#define LL 0\n"
"\n"
"\n"
"float x[3]={0};\n"
"float y[3]={0};\n"
"\n"
"float alpha = 0.05;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "x[2] = x[1]; x[1] = x[0]; x[0] = REF - InputSignal(0,0)"
";\n"
"y[2] = y[1]; y[1] = y[0];\n"
"y[0] = B0*x[0] + B1*x[1] + B2*x[2] - A1*y[1] - A2*y[2];\n"
"\t\n"
"\t\n"
"\t\n"
"y[0] = (y[0] > UL) ? UL : y[0];\n"
"y[0] = (y[0] < LL) ? LL : y[0];\n"
"\n"
"OutputSignal(0,0) = y[0];\n"
        Show          off
      }
