//#define REF 20.0f

//boost
#define B0 0.000532715f
#define B1 0.000532715f
#define B2 0.0f
#define A1 -1.000000f
#define A2 0.0f

#define UL 0.95f         // upper limit
#define LL 0.05f         // lower limit



__interrupt void Cla1Task1()
{

    x[2] = x[1]; x[1] = x[0]; x[0] = REF - fVal;
    y[2] = y[1]; y[1] = y[0];

    y[0] = B0*x[0] + B1*x[1] + B2*x[2] - A1*y[1] - A2*y[2];


    if (y[0] > UL) y[0] = UL;
    if (y[0] < LL) y[0] = LL;

    fResult = y[0];
}
